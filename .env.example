# ProspectIQ — local environment
#
# Copy to .env (or .env.local) and fill in. Both filenames are gitignored via `.env*`;
# .env.local wins over .env, matching Next.js.
#
# The real values live in the Vercel project. The quickest way to get them:
#
#   npx vercel link
#   npx vercel env pull .env.local
#
# Values may be quoted or unquoted — prisma.config.ts handles both.


# ── Database (required) ───────────────────────────────────────────────────────
# Supabase Postgres. The pooled connection string, port 6543.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# The direct connection, port 5432. Required for every `npx prisma migrate` command:
# DDL through the pooler in transaction mode either hangs or silently fails,
# so prisma.config.ts prefers this one for push/migrate and DATABASE_URL otherwise.
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Also accepted as fallbacks for DATABASE_URL, in this order. Vercel's Postgres
# integration sets them; you don't need them if DATABASE_URL is set.
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=


# ── Auth (required) ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The app's own origin. Must match where you're running it — this is what the
# email verification and password reset links are built from.
NEXTAUTH_URL="http://localhost:3000"


# ── Auth providers (optional; the button is hidden when unset) ───────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=


# ── AI and enrichment ────────────────────────────────────────────────────────
# Groq. Required — every engine (discovery, intelligence, outreach,
# conversation, orchestrator) calls it. Nothing in the pipeline runs without it.
GROQ_API_KEY=

# Serper.dev. Required for discovery and intelligence — they have no fallback
# search and will fail visibly without it, which is deliberate.
SERPER_API_KEY=

# Optional. Missing keys degrade a step rather than failing the run:
JINA_API_KEY=        # page-content scraping in discovery
HUNTER_API_KEY=      # contact email lookup in intelligence


# ── Email (optional) ─────────────────────────────────────────────────────────
# Resend. Without it, verification and reset emails are logged, not sent.
RESEND_API_KEY=


# ── Flags ────────────────────────────────────────────────────────────────────
# Gates /api/demo/seed and /api/demo/reset. Leave unset in production.
DEMO_MODE=

# Feature flags, read by lib/features.ts. Only the exact string "true" turns one
# on. Both are off by default because the features behind them are unfinished —
# turning one on doesn't build the missing half, it just stops hiding it.

# Sequences (/sequences). The route returns 404 while this is off. The schema and
# the page exist, but nothing outside lib/demo/seed.ts creates a sequence and
# there is no scheduler to advance one, so an enrolled contact never progresses.
ENABLE_SEQUENCES=

# Outbound sending. While this is off, the Outreach queue and the Conversations
# reply box say approving records a draft rather than emailing it, and setting an
# outreach message to SENT is refused. There is no send path for prospect email
# yet — lib/email.ts only handles verification and password reset — and no durable
# job runner to own one. Turn this on only once something actually sends.
ENABLE_OUTBOUND_SENDING=
