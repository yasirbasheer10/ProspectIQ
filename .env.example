# ProspectIQ — local environment
#
# Copy to .env (or .env.local) and fill in. Both filenames are gitignored via `.env*`;
# .env.local wins over .env, matching Next.js.
#
# The real values live in the Vercel project. The quickest way to get them:
#
#   npx vercel link
#   npx vercel env pull .env.local
#
# Values may be quoted or unquoted — prisma.config.ts handles both.


# ── Database (required) ───────────────────────────────────────────────────────
# Supabase Postgres. The pooled connection string, port 6543.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# The direct connection, port 5432. Required for every `npx prisma migrate` command:
# DDL through the pooler in transaction mode either hangs or silently fails,
# so prisma.config.ts prefers this one for push/migrate and DATABASE_URL otherwise.
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Also accepted as fallbacks for DATABASE_URL, in this order. Vercel's Postgres
# integration sets them; you don't need them if DATABASE_URL is set.
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=


# ── Auth (required) ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The app's own origin. Must match where you're running it — this is what the
# email verification and password reset links are built from.
NEXTAUTH_URL="http://localhost:3000"


# ── Auth providers (optional; the button is hidden when unset) ───────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=


# ── AI and enrichment ────────────────────────────────────────────────────────
# Groq. Required — it is the default for every engine (discovery, intelligence,
# outreach, conversation, orchestrator) and the fallback for the two below.
# Nothing in the pipeline runs without it.
GROQ_API_KEY=

# Serper.dev. Required for discovery and intelligence — they have no fallback
# search and will fail visibly without it, which is deliberate.
SERPER_API_KEY=

# Optional. Missing keys degrade a step rather than failing the run:
JINA_API_KEY=        # page-content scraping in discovery
HUNTER_API_KEY=      # contact email lookup in intelligence


# ── Kimi K3, the reasoning model (all optional) ──────────────────────────────
# Used only by the Growth Audit and by intelligence run on one company, where the
# quality of the thinking is the product. Leave every value below unset and both
# stay on Groq — that is the intended default, and an unconfigured or
# half-configured deploy silently keeps working rather than failing every run.
#
# Three things here are easy to get wrong, all of them found the hard way:
#   1. `model` is `moonshotai/Kimi-K3`, NOT the Modal app name on the dashboard.
#      Overridable with KIMI_MODEL, but the default is the one that works.
#   2. Auth is a Modal *proxy* token (Create proxy token), shaped
#      wk-<key>.ws-<secret>. The `ak-...` token on the account page is a
#      different credential, and with it requests die as a network error rather
#      than a 401. Anything not matching that shape leaves Kimi switched off.
#      The secret half is shown once at creation, so a lost one means a new pair.
#   3. It is a reasoning model at ~24x Groq's price, and about two thirds of
#      every output token is hidden reasoning billed at the completion rate. So
#      real cost is roughly 3x what the visible answer suggests.

# The endpoint host. With no trailing /v1 — it is added, and stripped if present.
KIMI_BASE_URL=

# The proxy token, both halves including the dot.
MODAL_PROXY_TOKEN=

# Which engines use it. Defaults to `audit,intelligence`. Set to `audit` to move
# intelligence back to Groq without touching the audit, or `none` for neither.
# `intelligence-fast` — the orchestrator's loop and the audit's own research pass
# — is excluded by default and should stay that way; both run many calls inside
# one invocation.
KIMI_ENGINES=

# Ceiling on completion tokens, hidden reasoning included. Defaults to 16000.
# Measured on real audit calls: 4,000-7,400 tokens of reasoning against only
# 640-920 of visible JSON, so a tighter cap truncates the audit mid-answer and
# the retry pays three times for nothing. The error names this setting when it
# happens. Worst case is ~24 cents for one call; typical is ~10.
KIMI_MAX_TOKENS=

# Request timeout in ms. Defaults to 180000. Throughput is ~85 tokens/sec, so a
# full audit is around a minute of generation — the usual 60s default is short.
KIMI_TIMEOUT_MS=

# Note for local work: `npm test` ignores everything in this section. Kimi is
# forced off whenever NODE_ENV=test or JEST_WORKER_ID is set, because jest
# inherits your shell and the engine test suites mock the Groq client — without
# that guard they call this paid endpoint for real, which has happened.


# ── Email (optional) ─────────────────────────────────────────────────────────
# Resend. Without it, verification and reset emails are logged, not sent.
RESEND_API_KEY=


# ── Flags ────────────────────────────────────────────────────────────────────
# Gates /api/demo/seed and /api/demo/reset. Leave unset in production.
DEMO_MODE=

# Feature flags, read by lib/features.ts. Only the exact string "true" turns one
# on. Both are off by default because the features behind them are unfinished —
# turning one on doesn't build the missing half, it just stops hiding it.

# Sequences (/sequences). The route returns 404 while this is off. The schema and
# the page exist, but nothing outside lib/demo/seed.ts creates a sequence and
# there is no scheduler to advance one, so an enrolled contact never progresses.
ENABLE_SEQUENCES=

# Outbound sending. While this is off, the Outreach queue and the Conversations
# reply box say approving records a draft rather than emailing it, and setting an
# outreach message to SENT is refused. There is no send path for prospect email
# yet — lib/email.ts only handles verification and password reset — and no durable
# job runner to own one. Turn this on only once something actually sends.
ENABLE_OUTBOUND_SENDING=
