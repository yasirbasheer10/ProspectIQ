// Prisma Schema — AI Revenue Agent
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum CompanyStatus {
  DISCOVERED
  RESEARCHING
  RESEARCHED
  QUALIFIED
  DISQUALIFIED
  IN_OUTREACH
  CONVERTED
  SUPPRESSED
}

enum OpportunityStatus {
  NEW
  REVIEWING
  APPROVED
  REJECTED
  IN_OUTREACH
  CONVERTED
  LOST
}

enum ContactStatus {
  UNVERIFIED
  VERIFIED
  BOUNCED
  OPTED_OUT
}

enum OutreachChannel {
  EMAIL
  LINKEDIN
  WHATSAPP
  PHONE
}

enum MessageStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  DELIVERED
  OPENED
  REPLIED
  BOUNCED
  FAILED
  REJECTED
}

enum SequenceStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum ReplyClassification {
  POSITIVE
  NEGATIVE
  NEUTRAL
  OUT_OF_OFFICE
  UNSUBSCRIBE
  QUESTION
  REFERRAL
  INTERESTED
  OBJECTION
  NOT_NOW
  MEETING_REQUEST
  UNKNOWN
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentRunType {
  DISCOVERY
  RESEARCH
  SCORING
  OUTREACH_GENERATION
  REPLY_CLASSIFICATION
  FOLLOW_UP_GENERATION
  DEMO_SEED
  DRAFT_OUTREACH
  ORCHESTRATOR
}

enum SignalType {
  HIRING
  FUNDING
  PRODUCT_LAUNCH
  LEADERSHIP_CHANGE
  EXPANSION
  TECHNOLOGY_CHANGE
  PAIN_POINT
  COMPETITOR_MENTION
  REGULATORY
  PARTNERSHIP
  AWARD
  PRESS_MENTION
  JOB_POSTING
}

// ─────────────────────────────────────────────────────────────
// WORKSPACE & USER
// ─────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  avatarUrl   String?
  accountType String   @default("COMPANY") // PERSON or COMPANY
  linkedInUrl String?
  demographics String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Auth fields
  passwordHash       String?
  emailVerified      DateTime?
  onboardingComplete Boolean @default(false)

  // Auth relations
  accounts           Account[]
  sessions           Session[]

  workspaces  WorkspaceMember[]
  agentRuns   AgentRun[]

  @@map("users")
}

model CustomAgent {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  goal        String?
  tools       Json     // Array of tools
  schedule    String   // continuous | daily | weekly
  budgetLimit Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companies   Company[]
  contacts    Contact[]
  outreachMessages OutreachMessage[]
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     WorkspaceMember[]
  icps        ICP[]
  offers      Offer[]
  companies   Company[]
  opportunities Opportunity[]
  contacts    Contact[]
  sequences   Sequence[]
  customAgents CustomAgent[]
  conversations Conversation[]
  agentRuns   AgentRun[]
  suppressions Suppression[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  role        String   @default("owner") // owner | member | viewer
  createdAt   DateTime @default(now())

  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

// ─────────────────────────────────────────────────────────────
// ICP & OFFER
// ─────────────────────────────────────────────────────────────

model ICP {
  id              String   @id @default(cuid())
  name            String
  description     String?
  
  // Firmographic filters
  industries      String[] // JSON array of industry names
  companySizeMin  Int?
  companySizeMax  Int?
  revenueMin      Float?
  revenueMax      Float?
  geographies     String[] // countries
  regions         String[]
  technologies    String[] // tech stack indicators
  businessModel   String[]
  
  // Behavioral indicators
  buyingSignals   String[] // keywords / signals to look for
  excludeKeywords String[]
  excludedIndustries String[]
  buyerRoles      String[]
  
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunities   Opportunity[]

  @@index([workspaceId])
  @@map("icps")
}

model Offer {
  id              String   @id @default(cuid())
  name            String
  description     String?
  valueProposition String?
  services        String[]
  targetProblems  String[] // problems this offer solves
  differentiators String[]
  buyerRoles      String[]
  relevantIndustries String[]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunities   Opportunity[]

  @@index([workspaceId])
  @@map("offers")
}

// ─────────────────────────────────────────────────────────────
// COMPANY
// ─────────────────────────────────────────────────────────────

model Company {
  id              String        @id @default(cuid())
  name            String
  domain          String?
  website         String?
  linkedinUrl     String?
  description     String?
  businessModel   String?       // B2B, B2C, Marketplace, SaaS, etc.
  industry        String?
  subIndustry     String?
  
  // Firmographics
  employeeCount   Int?
  employeeRange   String?       // "51-200"
  revenueRange    String?
  foundedYear     Int?
  headquarters    String?
  country         String?
  city            String?
  
  // Technology
  technologies    String[]
  
  // Status
  status          CompanyStatus @default(DISCOVERED)
  researchedAt    DateTime?
  researchScore   Float?        // 0-100 internal quality score
  
  // Source tracking
  discoverySource String?       // "demo" | "apollo" | "manual" | ...
  discoveryQuery  String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId         String?
  agent           CustomAgent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)
  signals         Signal[]
  evidence        Evidence[]
  opportunities   Opportunity[]
  contacts        Contact[]
  activities      Activity[]

  @@unique([workspaceId, domain])
  @@index([workspaceId])
  @@index([agentId])
  @@index([status])
  @@map("companies")
}

// ─────────────────────────────────────────────────────────────
// SIGNALS & EVIDENCE
// ─────────────────────────────────────────────────────────────

model Signal {
  id          String     @id @default(cuid())
  type        SignalType
  title       String
  description String?
  sourceUrl   String?
  sourceName  String?
  detectedAt  DateTime   @default(now())
  publishedAt DateTime?
  relevance   Float?     // 0-1 score
  
  createdAt   DateTime   @default(now())

  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  evidence    Evidence[]

  @@index([companyId])
  @@map("signals")
}

model Evidence {
  id          String   @id @default(cuid())
  title       String
  summary     String   // Human-readable summary of what was found
  quote       String?  // Exact quote from source
  sourceUrl   String?  // REQUIRED: URL where evidence was found
  sourceName  String?  // e.g. "LinkedIn", "TechCrunch", "Company Website"
  sourceType  String?  // "news" | "linkedin" | "job_board" | "website" | "crunchbase"
  capturedAt  DateTime @default(now())
  publishedAt DateTime?
  isVerified  Boolean  @default(false)
  
  createdAt   DateTime @default(now())

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  signalId    String?
  signal      Signal?  @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([signalId])
  @@map("evidence")
}

// ─────────────────────────────────────────────────────────────
// OPPORTUNITY & SCORING
// ─────────────────────────────────────────────────────────────

model Opportunity {
  id                    String            @id @default(cuid())
  status                OpportunityStatus @default(NEW)
  
  // The core problem-opportunity narrative
  problemStatement      String?           // What problem does this company have?
  whyNow                String?           // Why is now the right time to reach out?
  opportunitySummary    String?           // AI-generated narrative
  
  score                 OpportunityScore?
  
  // AI reasoning
  aiReasoning           String?           // Full reasoning text
  aiConfidence          Float?            // 0-1 model confidence
  
  // Recommendations
  recommendedService    String?
  recommendedBuyerRole  String?
  recommendedChannel    OutreachChannel?
  
  // Approval
  approvedAt            DateTime?
  approvedByUserId      String?
  rejectionReason       String?
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  companyId             String
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspaceId           String
  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  icpId                 String?
  icp                   ICP?              @relation(fields: [icpId], references: [id])
  offerId               String?
  offer                 Offer?            @relation(fields: [offerId], references: [id])
  contacts              Contact[]
  outreachMessages      OutreachMessage[]
  conversations         Conversation[]

  @@index([companyId])
  @@index([workspaceId])
  @@index([icpId])
  @@index([offerId])
  @@index([status])
  @@map("opportunities")
}

model OpportunityScore {
  id                    String      @id @default(cuid())
  icpFitScore           Float?      // Weight: 20%
  problemEvidenceScore  Float?      // Weight: 25%
  buyingIntentScore     Float?      // Weight: 20%
  serviceMatchScore     Float?      // Weight: 15%
  buyerConfidenceScore  Float?      // Weight: 10%
  contactabilityScore   Float?      // Weight: 10%
  overallScore          Float?      // Weighted composite

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  opportunityId         String      @unique
  opportunity           Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@map("opportunity_scores")
}

// ─────────────────────────────────────────────────────────────
// CONTACTS
// ─────────────────────────────────────────────────────────────

model Contact {
  id              String        @id @default(cuid())
  firstName       String?
  lastName        String?
  fullName        String
  title           String?
  seniority       String?       // "C-Suite" | "VP" | "Director" | "Manager"
  department      String?
  
  // Contact details — only store verified/sourced info
  email           String?
  emailStatus     ContactStatus @default(UNVERIFIED)
  emailSource     String?       // where the email came from
  linkedinUrl     String?
  phone           String?
  phoneSource     String?
  
  // Source verification
  sourceUrl       String?       // where this contact was found
  sourceName      String?
  isVerified      Boolean       @default(false)
  
  buyerScore      Float?        // 0-100, how relevant for purchase decision
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  isUnsubscribed  Boolean       @default(false)

  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspaceId     String
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId         String?
  agent           CustomAgent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)
  outreachMessages OutreachMessage[]
  conversations   Conversation[]
  
  opportunityId   String?
  opportunity     Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([workspaceId])
  @@index([agentId])
  @@index([opportunityId])
  @@index([emailStatus])
  @@map("contacts")
}

// ─────────────────────────────────────────────────────────────
// OUTREACH
// ─────────────────────────────────────────────────────────────

model Sequence {
  id          String         @id @default(cuid())
  name        String
  description String?
  channel     OutreachChannel @default(EMAIL)
  status      SequenceStatus  @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps       SequenceStep[]
  messages    OutreachMessage[]

  @@index([workspaceId])
  @@map("sequences")
}

model SequenceStep {
  id          String   @id @default(cuid())
  stepNumber  Int
  delayDays   Int      @default(0)  // days after previous step
  subject     String?
  bodyTemplate String  // Handlebars-style template
  channel     OutreachChannel @default(EMAIL)
  createdAt   DateTime @default(now())

  sequenceId  String
  sequence    Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, stepNumber])
  @@index([sequenceId])
  @@map("sequence_steps")
}

model OutreachMessage {
  id              String          @id @default(cuid())
  channel         OutreachChannel @default(EMAIL)
  status          MessageStatus   @default(DRAFT)
  subject         String?
  body            String          // The actual personalized message
  
  // Personalization evidence — what sources drove this message
  personalizationNotes String?
  evidenceUsed    String[]        // IDs of Evidence records used
  
  // Sending metadata
  sentAt          DateTime?
  deliveredAt     DateTime?
  openedAt        DateTime?
  repliedAt       DateTime?
  
  // Approval
  approvedAt      DateTime?
  approvedByUserId String?
  
  // Scheduling
  scheduledFor    DateTime?
  stepNumber      Int?            // which step in the sequence
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  opportunityId   String?
  opportunity     Opportunity?    @relation(fields: [opportunityId], references: [id])
  contactId       String?
  contact         Contact?        @relation(fields: [contactId], references: [id])
  sequenceId      String?
  sequence        Sequence?       @relation(fields: [sequenceId], references: [id])
  agentId         String?
  agent           CustomAgent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  conversation    Conversation?

  @@index([opportunityId])
  @@index([contactId])
  @@index([sequenceId])
  @@index([agentId])
  @@index([status])
  @@map("outreach_messages")
}

// ─────────────────────────────────────────────────────────────
// CONVERSATIONS
// ─────────────────────────────────────────────────────────────

model Conversation {
  id              String              @id @default(cuid())
  status          ConversationStatus  @default(ACTIVE)
  subject         String?
  channel         OutreachChannel     @default(EMAIL)
  
  // Intelligence
  lastReplyAt     DateTime?
  replyCount      Int                 @default(0)
  lastClassification ReplyClassification?
  sentiment       String?             // "positive" | "neutral" | "negative"
  
  // Suggested next action
  suggestedAction String?
  suggestedActionReason String?
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  workspaceId     String
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunityId   String?
  opportunity     Opportunity?        @relation(fields: [opportunityId], references: [id])
  contactId       String?
  contact         Contact?            @relation(fields: [contactId], references: [id])
  outreachMessageId String?           @unique
  outreachMessage OutreachMessage?    @relation(fields: [outreachMessageId], references: [id])
  messages        ConversationMessage[]
  activities      Activity[]

  @@index([workspaceId])
  @@index([opportunityId])
  @@index([contactId])
  @@index([outreachMessageId])
  @@index([status])
  @@map("conversations")
}

model ConversationMessage {
  id              String              @id @default(cuid())
  direction       String              // "outbound" | "inbound"
  body            String
  sentAt          DateTime            @default(now())
  classification  ReplyClassification?
  aiSummary       String?
  suggestedReply  String?
  
  conversationId  String
  conversation    Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_messages")
}

// ─────────────────────────────────────────────────────────────
// ACTIVITY LOG
// ─────────────────────────────────────────────────────────────

model Activity {
  id          String   @id @default(cuid())
  type        String   // "company_researched" | "opportunity_created" | "email_sent" | ...
  title       String
  description String?
  metadata    Json?    // flexible payload
  createdAt   DateTime @default(now())

  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([conversationId])
  @@map("activities")
}

// ─────────────────────────────────────────────────────────────
// AGENT RUNS
// ─────────────────────────────────────────────────────────────

model AgentRun {
  id          String         @id @default(cuid())
  type        AgentRunType
  status      AgentRunStatus @default(QUEUED)
  title       String
  description String?
  
  // Progress tracking
  totalItems  Int?
  processedItems Int         @default(0)
  
  // Results
  resultSummary String?
  errorMessage  String?
  
  // Metadata
  inputParams Json?
  outputData  Json?
  
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  workspaceId String?
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id])

  @@index([userId])
  @@index([workspaceId])
  @@index([status])
  @@map("agent_runs")
}

// ─────────────────────────────────────────────────────────────
// SUPPRESSION LIST
// ─────────────────────────────────────────────────────────────

model Suppression {
  id          String   @id @default(cuid())
  type        String   // "domain" | "email" | "company_id"
  value       String   // the domain / email / company ID to suppress
  reason      String?  // "opted_out" | "competitor" | "existing_customer" | "bad_fit"
  createdAt   DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type, value])
  @@index([workspaceId])
  @@map("suppressions")
}

// ─────────────────────────────────────────────────────────────
// AUTHENTICATION
// ─────────────────────────────────────────────────────────────

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("password_reset_tokens")
}
